// Wealth Dashboard — Prisma schema (Next.js 16 + Auth.js v5 + SQLite dev)
// 2026-07-07 Session 2 — 加入用戶系統 + 雲端同步

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 標準 model ───
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  assets       Asset[]
  transactions Transaction[]
  subscription Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── 商業化：訂閱 ───
model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String   @default("free") // free / pro / business
  status    String   @default("active") // active / canceled / past_due
  stripeId  String?
  startedAt DateTime @default(now())
  endsAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── 業務核心：資產 ───
model Asset {
  id           String   @id @default(cuid())
  userId       String
  name         String
  value        Float    // 當前價值（原幣）
  costBasis    Float?   // 成本基礎
  category     String   // cash / stock / fund / crypto / real-estate / other
  currency     String   @default("TWD")
  institution  String?
  symbol       String?  // 股票/加密貨幣代號
  quantity     Float?   // 持股數量
  avgPrice     Float?   // 平均成本價
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// ─── 業務延伸：交易紀錄 ───
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  assetId   String?
  type      String   // buy / sell / dividend / deposit / withdrawal
  amount    Float
  currency  String   @default("TWD")
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}